# Voice AI Manager — переменные окружения
# ВНИМАНИЕ: demo-режим работает без каких-либо переменных.
# Все значения ниже нужны только для будущего live-режима и НЕ являются секретами.

# --- Безопасность webhook / контракта (live) ---
# HMAC-SHA256 секрет для подписи входящих webhook и исходящих событий.
# Demo использует встроенный небоевой секрет, live ОБЯЗАН задать свой:
#   openssl rand -hex 32
VOICE_WEBHOOK_SECRET=

# --- Политика хранения ---
# Срок хранения транскриптов в днях (по умолчанию 90).
VOICE_TRANSCRIPT_RETENTION_DAYS=90

# --- Live-провайдеры (НЕ подключены, зарезервировано под будущее) ---
# Телефония
# TELEPHONY_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# STT / TTS / LLM
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# CRM
# CRM_BASE_URL=
# CRM_API_KEY=

# Календарь
# GOOGLE_CALENDAR_CREDENTIALS=

# Сообщения
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_API_KEY=

# Control Center
# CONTROL_CENTER_WEBHOOK_URL=
# CONTROL_CENTER_SECRET=
